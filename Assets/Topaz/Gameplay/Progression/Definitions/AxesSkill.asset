  m_Script: {fileID: 11500000, guid: 8a0977114d5ce4c5ebbca786a7e5cae0, type: 3}
  m_Name: AxesSkill
  m_EditorClassIdentifier: Assembly-CSharp::Topaz.LoopStudy.SkillDefinition
  stableId: axes
  displayName: Axes
  levelBenefit: Axe recovery is 1% quicker per level. +1 damage at levels 5 and 10.
  handlingPerLevel: 0.01
  benefitAtFive: 1
  benefitAtTen: 1
  talents:
  - id: axes.bleed
    label: Bleed
    description: 'Axe hits cause non-stacking bleed: one damage after 1.5 seconds. Bleed can finish enemies.'
    amount: 1
    durationSeconds: 2
    intervalSeconds: 1.5
  - id: axes.rage
    label: Rage
    description: Taking real enemy damage with the axe equipped grants +20% Axe damage for five seconds; further hits refresh it.
    amount: 0.2
    durationSeconds: 5
    intervalSeconds: 0
  - id: axes.heavy-impact
    label: Heavy Impact
    description: Staggerable enemies recover 0.1 seconds later from an axe hit.
    amount: 0.1
    durationSeconds: 0
    intervalSeconds: 0
  - id: axes.finishing-blow
    label: Finishing Blow
    description: Axe hits deal +1 damage to enemies already at half health or less.
    amount: 1
    durationSeconds: 0
    intervalSeconds: 0
